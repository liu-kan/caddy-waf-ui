# Docker env_file for the UI and config initializer; not a shell script.
# Store the real ui.env outside the source checkout, mode 0600.
CADDY_UI_TOKEN=replace-with-openssl-rand-hex-32
CADDY_UI_BIND=0.0.0.0:8080
CADDY_ADMIN_URL=unix:///run/caddy-admin/admin.sock
CADDY_UI_CADDYFILE=/etc/caddy/Caddyfile
CADDY_UI_MANAGED_DIR=/ui-managed
CADDY_UI_INCLUDE_DIR=/etc/caddy/ui-managed
CADDY_UI_BACKUP_DIR=/backups
CADDY_UI_BACKUP_KEEP=10
CADDY_UI_DATA_DIR=/ui-data
CADDY_UI_SITES=chat.example.com
CADDY_UI_NODE=ip-172-31-2-69
CADDY_UI_LOG_LEVEL=info
GOMEMLIMIT=160MiB

CADDY_UI_CRS_MODE=embedded
CADDY_UI_WAF_BEFORE_FILE=/etc/caddy/waf-custom/waf-before.conf
CADDY_UI_WAF_AFTER_FILE=/etc/caddy/waf-custom/waf-after.conf
CADDY_UI_RESPONSE_BODY_ACCESS=Off
CADDY_UI_AUDIT_LOG_PARTS=AHKZ
CADDY_UI_AUDIT_LOG=/var/log/caddy/coraza-audit.json
# Keep host logrotate during initial acceptance. Enable UI rotation later.
CADDY_UI_AUDIT_ROTATE_MB=0
CADDY_UI_AUDIT_ARCHIVE_HOURS=48
CADDY_UI_INGEST_INTERVAL=2s
CADDY_UI_EVENTS_RETENTION_DAYS=14
CADDY_UI_EVENTS_MEMORY_MAX=1000
CADDY_UI_EVENTS_DISK_MAX_MB=128
CADDY_UI_CLOUD_DISK_MAX_MB=128
CADDY_UI_CLOUD_EXPORT=true

CADDY_UI_REDACTION_LOCAL=standard
CADDY_UI_REDACTION_CLOUD=strict
CADDY_UI_REDACTION_HIDE=customer_email,internal_note
CADDY_UI_REDACTION_KEEP=

# HTTPS goes directly to the Caddy service; SNI/Host use the managed domain.
# Use a harmless path that works through the existing auth and routing.
CADDY_UI_PROBE_URLS={"chat.example.com":"https://caddy/__waf_health"}
CADDY_UI_IPGROUP_DIR=/ipgroups
CADDY_UI_IPGROUP_MAX_PREFIXES=100000
CADDY_UI_IPGROUP_PROXY=

# Only a logs:read token belongs here. Leave all three empty for local-only use.
CADDY_UI_LOKI_URL=
CADDY_UI_LOKI_USER=
CADDY_UI_LOKI_TOKEN=
CADDY_UI_LOKI_SELECTOR={job="caddy-waf-ui",kind="event"}
CADDY_UI_LOKI_SYNC_INTERVAL=0s
CADDY_UI_GRAFANA_URL=
CADDY_UI_GRAFANA_LOKI_DATASOURCE=grafanacloud-logs
# Existing host metrics continue unchanged; WAF-specific metrics are opt-in.
CADDY_UI_METRICS_TOKEN=
