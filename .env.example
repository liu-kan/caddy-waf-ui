# Existing backend image: replace with your actual Docker Hub tag or digest.
# This repository builds only the UI, never the backend.
CADDY_IMAGE=liukan/caddy-with-auth:latest
CADDY_UI_TOKEN=replace-with-openssl-rand-hex-32

# Ready-to-run local example. For production point to your existing Caddyfile,
# enumerate its UI-managed domains and retain your trusted proxy/auth settings.
CADDYFILE_PATH=./Caddyfile.example
CADDY_UI_SITES=localhost
CADDY_ADMIN_URL=unix:///run/caddy-admin/admin.sock
CADDY_UI_CADDYFILE=/etc/caddy/Caddyfile
CADDY_UI_MANAGED_DIR=/ui-managed
CADDY_UI_INCLUDE_DIR=/etc/caddy/ui-managed
CADDY_UI_BACKUP_DIR=/backups
CADDY_UI_BACKUP_KEEP=10
CADDY_UI_BIND=0.0.0.0:8080
CADDY_UI_LOG_LEVEL=info
CADDY_UI_AUDIT_LOG=/data/logs/coraza-audit.log

# Embedded CRS is provided by coraza-caddy/v2, with no packaged file dependency.
# To use mounted rules set files and override all three paths as appropriate.
CADDY_UI_CRS_MODE=embedded
CADDY_UI_CORAZA_CONFIG=
CADDY_UI_CRS_SETUP=
CADDY_UI_CRS_RULES=
CADDY_UI_WAF_BEFORE_FILE=/etc/caddy/waf-custom/before.conf
CADDY_UI_WAF_AFTER_FILE=/etc/caddy/waf-custom/after.conf
CADDY_UI_RESPONSE_BODY_ACCESS=Off
# AHKZ records method, URI and rule matches without request headers or bodies.
# ABHKZ also keeps request headers (Cookie, Authorization) in the local raw
# audit log for header diagnostics; Alloy never ships the raw log.
CADDY_UI_AUDIT_LOG_PARTS=AHKZ
EXAMPLE_APP_IMAGE=containous/whoami:v1.5.0

# Persistent normalized data; bounded event cache and compact disk-offset index.
CADDY_UI_EVENTS_MEMORY_MAX=1000
CADDY_UI_EVENTS_RETENTION_DAYS=14
CADDY_UI_EVENTS_DISK_MAX_MB=128
CADDY_UI_NODE=caddy-local
CADDY_UI_AUDIT_ROTATE_MB=32
CADDY_UI_MATCHED_VALUES=false
CADDY_UI_LOKI_SYNC_INTERVAL=0s
# Origin URL map, independently selected for each managed site.
# Use your HTTPS origin URL for production; redirects are never followed.
CADDY_UI_PROBE_URLS={"localhost":"http://caddy"}
# Optional Grafana Cloud profile: docker compose --profile cloud up -d
ALLOY_IMAGE=grafana/alloy:v1.20.0
GRAFANA_CLOUD_LOKI_URL=
CADDY_UI_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOGS_WRITE_TOKEN=
GRAFANA_CLOUD_LOGS_READ_TOKEN=
CADDY_UI_LOKI_SELECTOR=
CADDY_UI_GRAFANA_URL=
# Optional metric scraping; set a separate random token and append metrics example.
CADDY_UI_METRICS_TOKEN=
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_METRICS_WRITE_TOKEN=
