# Existing backend image: replace with your actual Docker Hub tag or digest.
# This repository builds only the UI, never the backend.
CADDY_IMAGE=liukan/caddy-with-auth:latest
CADDY_UI_TOKEN=replace-with-openssl-rand-hex-32

# Ready-to-run local example. For production point to your existing Caddyfile,
# enumerate its UI-managed domains and retain your trusted proxy/auth settings.
CADDYFILE_PATH=./Caddyfile.example
CADDY_UI_SITES=localhost
CADDY_ADMIN_URL=unix:///run/caddy-admin/admin.sock
CADDY_UI_CADDYFILE=/etc/caddy/Caddyfile
CADDY_UI_MANAGED_DIR=/ui-managed
CADDY_UI_INCLUDE_DIR=/etc/caddy/ui-managed
CADDY_UI_BACKUP_DIR=/backups
CADDY_UI_BACKUP_KEEP=10
CADDY_UI_BIND=0.0.0.0:8080
CADDY_UI_LOG_LEVEL=info
CADDY_UI_AUDIT_LOG=/data/logs/coraza-audit.log

# Embedded CRS is provided by coraza-caddy/v2, with no packaged file dependency.
# To use mounted rules set files and override all three paths as appropriate.
CADDY_UI_CRS_MODE=embedded
CADDY_UI_CORAZA_CONFIG=
CADDY_UI_CRS_SETUP=
CADDY_UI_CRS_RULES=
CADDY_UI_WAF_BEFORE_FILE=/etc/caddy/waf-custom/before.conf
CADDY_UI_WAF_AFTER_FILE=/etc/caddy/waf-custom/after.conf
CADDY_UI_RESPONSE_BODY_ACCESS=Off
# Excludes request/response headers and bodies. Rule matches can still contain
# sensitive fragments. Add B only when you accept logging request headers/URI.
CADDY_UI_AUDIT_LOG_PARTS=AHKZ
EXAMPLE_APP_IMAGE=containous/whoami:v1.5.0
