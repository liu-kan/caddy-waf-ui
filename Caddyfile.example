# A runnable local example using the existing caddy-with-auth image.
# For production, keep your existing TLS/auth/trusted_proxies/routing and
# add the two managed imports inside a route. List their domains in CADDY_UI_SITES.
{
	admin {$CADDY_ADMIN_LISTEN:unix//run/caddy-admin/admin.sock}
	order coraza_waf first
	skip_install_trust
	# Runtime errors stay local; Alloy ships only timestamp, level and logger.
	log default {
		output file /data/logs/error.json {
			roll_size 5MiB
			roll_keep 2
			roll_keep_for 48h
		}
		format json
		level ERROR
	}
}

http://localhost {
	# Access metadata for request totals; headers and query values are removed.
	log {
		output file /data/logs/access.json {
			roll_size 5MiB
			roll_keep 2
			roll_keep_for 48h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	log_append request_path {http.request.uri.path}
	route {
		import /etc/caddy/ui-managed/ip-rules-localhost.conf
		import /etc/caddy/ui-managed/waf-localhost.conf
		reverse_proxy example-app:80
	}
}
